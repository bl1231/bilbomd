# id -u   # paste result as UID
# id -g   # paste result as GID
# getent group docker | cut -d: -f3   # paste result as DOCKER_GID
UID=501
GID=1231
DOCKER_GID=973

# development or production
BILBOMD_ENV=development
# bl1231, nersc, or local
BILBOMD_DEPLOY_SITE=local
BILBOMD_DEV_BIND_ADDR=127.0.0.1
BILBOMD_BACKEND_PORT=3501
BILBOMD_URL=http://localhost
BILBOMD_FQDN=localhost
# CORS: the UI origin (BILBOMD_URL:BILBOMD_UI_PORT) is allowed automatically.
# Add extra origins only if needed (comma-separated):
# CORS_ALLOWED_ORIGINS=http://other-host:3001

# 3001 for production on hyperion
# This is the port that Apache/NGINX will be connecting to.
BILBOMD_UI_PORT=3001

# Secrets for signing the JWT Tokens
# run this command four times in a terminal with nodejs in the path:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# paste the results in the appropriate fields below
ACCESS_TOKEN_SECRET=xxxxxxxxxxx
REFRESH_TOKEN_SECRET=xxxxxxxxxxx
SESSION_SECRET=xxxxxxxxxxx
HASH_IP_SALT=xxxxxxxxxxx

# MongoDB
MONGO_USERNAME=xxxxxxxxxxx
MONGO_PASSWORD=xxxxxxxxxxx
MONGO_HOSTNAME=mongodb
MONGO_PORT=27017
MONGO_DB=bilbomd
MONGO_AUTH_SRC=admin

# MongoDB - needed for external access
MONGO_DEV_BIND_ADDR=127.0.0.1
MONGO_EXTERNAL_PORT=28017

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=xxxxxxxxxxx

# Redis - needed for external access
REDIS_DEV_BIND_ADDR=127.0.0.1
REDIS_EXTERNAL_PORT=7379

# Various settings for altering the way the app behaves.
SEND_EMAIL_USER=bilbomd@lbl.gov
SEND_EMAIL_NOTIFICATIONS=false

# SMTP mail server settings
# Change BILBOMD_MAILER_HOST for local installs (e.g. localhost for Mailhog or a local relay)
BILBOMD_MAILER_HOST=smtp-relay.gmail.com
BILBOMD_MAILER_PORT=25
BILBOMD_MAILER_SECURE=false
# Optional: set if your SMTP server requires authentication
# BILBOMD_MAILER_USER=
# BILBOMD_MAILER_PASS=
DATA_VOL=/bilbomd/uploads
EXAMPLE_DATA=/app/examples
BILBOMD_LOGS=/bilbomd/logs
CHARMM_VER=c47b2
CHARMM_TOPOLOGY=/app/scripts/bilbomd_top_par_files.str
CHARMM_TEMPLATES=/app/build/templates/bilbomd
CHARMM=/usr/local/bin/charmm
FOXS=/usr/bin/foxs
MULTIFOXS=/usr/bin/multi_foxs
# OPENMM_PYTHON_BIN=/opt/envs/openmm/bin/python  # optional, this is the default
# BASE_PYTHON_BIN=/opt/envs/base/bin/python       # optional, this is the default
SCOPER_KGS_CONFORMERS=1000
BULLMQ_ATTEMPTS=2

# Feature toggles
ENABLE_BILBOMD_SANS=false
ENABLE_BILBOMD_MULTI=true
# Local AlphaFold (OpenMM-only) requires:
#   - HOST_UPLOAD_DIR set to the host path that backs DATA_VOL inside the worker
#   - HOST_COLABFOLD_CACHE pre-created on the host (~50GB after first run)
#   - /var/run/docker.sock mounted into the worker
#   - GPU available to the worker container
# CHARMM AlphaFold still requires NERSC.
ENABLE_BILBOMD_ALPHAFOLD=false
ENABLE_BILBOMD_SCOPER=false
ENABLE_HOME_PAGE_ALERT=false
ENABLE_CHARMM_ENGINE=true         # set to false to hide/disable CHARMM as an md_engine option

# Local AlphaFold (when ENABLE_BILBOMD_ALPHAFOLD=true and USE_NERSC=false)
HOST_UPLOAD_DIR=/bilbomd/uploads             # host-side path that maps to DATA_VOL inside the worker
HOST_COLABFOLD_CACHE=/bilbomd/colabfold-cache
COLABFOLD_IMAGE=bl1231/bilbomd-colabfold:latest
COLABFOLD_TIMEOUT_MS=3600000                 # 1h default per AF run

# NERSC stuff
# only needed by SIBYLS.
USE_NERSC=false
NERSC_PROJECT=xxxxxxxxxxx
SFAPI_CLIENT_ID=xxxxxxxxxxx
SFAPI_CLIENT_SECRET=xxxxxxxxxxx
SFAPI_URL="https://example.gov/api/v1"
SCRIPT_DIR=/app/scripts
UPLOAD_DIR=/app/uploads
WORK_DIR=/app/work
PREPARE_CHARMM_SLURM_SCRIPT=gen-sbatch.sh
PREPARE_OMM_SLURM_SCRIPT=gen-sbatch-omm.py
CP2CFS_SCRIPT=copy2cfs.sh

# ORCID OAUTH stuff
# Not implemented yet.
# SANDBOX
ORCID_CLIENT_ID=APP-XXXXXXXXXXX
ORCID_CLIENT_SECRET=XXXXXXXXXXXXXXXX
# PRODUCTION
# ORCID_CLIENT_ID=APP-XXXXXXXXXXX
# ORCID_CLIENT_SECRET=XXXXXXXXXXXXXXXX
# The redirect URI must match the one registered with ORCID for the application.
# https://bilbomd.bl1231.als.lbl.gov/api/v1/auth/orcid/callback
# https://bilbomd-dev.bl1231.als.lbl.gov/api/v1/auth/orcid/callback
# https://bilbomd-nersc.bl1231.als.lbl.gov/api/v1/auth/orcid/callback
# https://bilbomd-nersc-dev.bl1231.als.lbl.gov/api/v1/auth/orcid/callback
ORCID_REDIRECT_URI=https://bilbomd.bl1231.als.lbl.gov/api/v1/auth/orcid/callback
ORCID_BASE_URL=https://sandbox.orcid.org
# Public API: https://pub.sandbox.orcid.org/[version]
# Member API: https://api.sandbox.orcid.org/[version]
ORCID_PUBLIC_API_URL=https://pub.sandbox.orcid.org/v3.0
ORCID_MEMBER_API_URL=https://api.sandbox.orcid.org/v3.0
