# id -u   # paste result as UID
# id -g   # paste result as GID
UID=501
GID=1231

# development or production
BILBOMD_ENV=development
# Winston log level: error, warn, info, http, verbose, debug, silly (default: info)
LOG_LEVEL=debug
# bl1231, nersc, or local
BILBOMD_DEPLOY_SITE=local
BILBOMD_DEV_BIND_ADDR=127.0.0.1
BILBOMD_BACKEND_PORT=3501
# BILBOMD_URL is the EXACT public base URL users type into their browser, and is
# used verbatim to build the links in verification / magic-link / OTP emails.
# Include the port if it is non-standard:
#   - Behind a TLS reverse proxy:  https://your.domain        (443 implied)
#   - Direct / no proxy:           http://localhost:3001      (port REQUIRED)
# Do NOT rely on BILBOMD_UI_PORT to supply the port here — that is the host port
# the UI is published on, which differs from the public port when a proxy is in
# front (e.g. proxy on 443 -> container 3001). The two cannot be derived from
# each other, so the full public URL must be stated explicitly.
BILBOMD_URL=http://localhost:3001
BILBOMD_FQDN=localhost
# CORS: the BILBOMD_URL origin is allowed automatically. If BILBOMD_URL has no
# explicit port, the BILBOMD_URL:BILBOMD_UI_PORT combination is allowed too.
# Add extra origins only if needed (comma-separated):
# CORS_ALLOWED_ORIGINS=http://other-host:3001

# 3001 for production on hyperion
# This is the port that Apache/NGINX will be connecting to.
BILBOMD_UI_PORT=3001

# Auth/session cookies use the Secure attribute (HTTPS-only) by default when
# BILBOMD_ENV=production. Browsers SILENTLY DROP Secure cookies over plain HTTP,
# which breaks login and token refresh for installs accessed via http://
# (e.g. http://localhost:3001 with no TLS-terminating proxy). If you run over
# plain HTTP, set COOKIE_SECURE=false. Leave unset (or true) when serving over
# HTTPS. Cookies sent without Secure travel unencrypted — only relax this on a
# trusted/local network.
# COOKIE_SECURE=false

# Secrets for signing the JWT Tokens
# run this command four times in a terminal with nodejs in the path:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# paste the results in the appropriate fields below
ACCESS_TOKEN_SECRET=xxxxxxxxxxx
REFRESH_TOKEN_SECRET=xxxxxxxxxxx
SESSION_SECRET=xxxxxxxxxxx
HASH_IP_SALT=xxxxxxxxxxx

# MongoDB
MONGO_USERNAME=xxxxxxxxxxx
MONGO_PASSWORD=xxxxxxxxxxx
MONGO_HOSTNAME=mongodb
MONGO_PORT=27017
MONGO_DB=bilbomd
MONGO_AUTH_SRC=admin

# MongoDB - needed for external access
MONGO_DEV_BIND_ADDR=127.0.0.1
MONGO_EXTERNAL_PORT=28017

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Redis - needed for external access
REDIS_DEV_BIND_ADDR=127.0.0.1
REDIS_EXTERNAL_PORT=7379

# Various settings for altering the way the app behaves.
SEND_EMAIL_USER=bilbomd@lbl.gov
SEND_EMAIL_NOTIFICATIONS=false

# SMTP mail server settings
# Change BILBOMD_MAILER_HOST for local installs (e.g. localhost for Mailhog or a local relay)
BILBOMD_MAILER_HOST=smtp-relay.gmail.com
BILBOMD_MAILER_PORT=25
BILBOMD_MAILER_SECURE=false
# Optional: set if your SMTP server requires authentication
# BILBOMD_MAILER_USER=
# BILBOMD_MAILER_PASS=

DATA_VOL=/bilbomd/uploads
EXAMPLE_DATA=/app/examples
BILBOMD_LOGS=/bilbomd/logs
CHARMM_VER=c47b2
CHARMM_TOPOLOGY=/app/scripts/bilbomd_top_par_files.str
CHARMM_TEMPLATES=/app/build/templates/bilbomd
CHARMM=/usr/local/bin/charmm
FOXS=/usr/bin/foxs
MULTIFOXS=/usr/bin/multi_foxs
# OPENMM_PYTHON_BIN=/opt/envs/openmm/bin/python  # optional, this is the default
# BASE_PYTHON_BIN=/opt/envs/base/bin/python       # optional, this is the default
SCOPER_KGS_CONFORMERS=1000
BULLMQ_ATTEMPTS=2

# Feature toggles
ENABLE_BILBOMD_SANS=false
ENABLE_BILBOMD_MULTI=true
ENABLE_BILBOMD_ALPHAFOLD=false
ENABLE_BILBOMD_OPENFOLD=false
ENABLE_BILBOMD_SCOPER=false
ENABLE_HOME_PAGE_ALERT=false
ENABLE_CHARMM_ENGINE=false

# Local AlphaFold sidecar service (when ENABLE_BILBOMD_ALPHAFOLD=true and USE_NERSC=false)
# The service URL is injected automatically by docker-compose; override only if needed.
COLABFOLD_SERVICE_URL=http://colabfold-service:8000
COLABFOLD_TIMEOUT_MS=3600000                 # 1h default per AF run

# Local OpenFold3 sidecar service (when ENABLE_BILBOMD_OPENFOLD=true)
# The service URL is injected automatically by docker-compose; override only if needed.
OF3_SERVICE_URL=http://of3-service:8000
OF3_TIMEOUT_MS=3600000                      # 1h default per OF3 run

# Setting this to a value > 1 will enable NVIDIA MPS allowing multipel MD jobs to share a GPU.
OPENMM_MD_CONCURRENCY=1

# NERSC stuff
# only needed by SIBYLS.
USE_NERSC=false
NERSC_PROJECT=xxxxxxxxxxx
SFAPI_CLIENT_ID=xxxxxxxxxxx
SFAPI_URL="https://example.gov/api/v1"
SCRIPT_DIR=/app/scripts
UPLOAD_DIR=/app/uploads
WORK_DIR=/app/work
PREPARE_CHARMM_SLURM_SCRIPT=gen-sbatch.sh
PREPARE_OMM_SLURM_SCRIPT=gen-sbatch-omm.py
CP2CFS_SCRIPT=copy2cfs.sh

# ORCID OAUTH stuff
# Feature flag — ORCID login is currently disabled in production while the
# hardening work tracked in https://github.com/bl1231/bilbomd/issues/817
# is completed. When 'false' (the default), the backend does not register
# /api/v1/auth/orcid/* routes, skips OIDC discovery on startup, and the UI
# /login page redirects to /magicklink. Set to 'true' only in dev/staging
# while testing the hardened flow.
ORCID_AUTH_ENABLED=false
#
# When ORCID_AUTH_ENABLED=true, ALL of the following must be set. The backend
# fails fast on startup if any is missing — no sandbox/production fallbacks
# are applied. Switch between the PRODUCTION and SANDBOX blocks below as a
# unit; never mix endpoints across environments.
#
# --- PRODUCTION (default) ---
ORCID_CLIENT_ID=APP-XXXXXXXXXXX
ORCID_CLIENT_SECRET=XXXXXXXXXXXXXXXX
ORCID_ISSUER=https://orcid.org
ORCID_BASE_URL=https://orcid.org
ORCID_PUBLIC_API_URL=https://pub.orcid.org/v3.0
ORCID_MEMBER_API_URL=https://api.orcid.org/v3.0
#
# --- SANDBOX (uncomment for dev/staging) ---
# ORCID_CLIENT_ID=APP-XXXXXXXXXXX
# ORCID_CLIENT_SECRET=XXXXXXXXXXXXXXXX
# ORCID_ISSUER=https://sandbox.orcid.org
# ORCID_BASE_URL=https://sandbox.orcid.org
# ORCID_PUBLIC_API_URL=https://pub.sandbox.orcid.org/v3.0
# ORCID_MEMBER_API_URL=https://api.sandbox.orcid.org/v3.0
#
# The redirect URI must match the one registered with ORCID for the application.
# Examples:
#   https://bilbomd.bl1231.als.lbl.gov/api/v1/auth/orcid/callback
#   https://bilbomd-dev.bl1231.als.lbl.gov/api/v1/auth/orcid/callback
#   https://bilbomd-nersc.bl1231.als.lbl.gov/api/v1/auth/orcid/callback
#   https://bilbomd-nersc-dev.bl1231.als.lbl.gov/api/v1/auth/orcid/callback
ORCID_REDIRECT_URI=https://bilbomd.bl1231.als.lbl.gov/api/v1/auth/orcid/callback
