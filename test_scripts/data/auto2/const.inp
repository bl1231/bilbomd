define fixed1 sele ( resid 222:359 .and. segid PROA ) end
define fixed2 sele ( resid 369:668 .and. segid PROA ) end
define fixed3 sele ( resid 682:805 .and. segid PROA ) end
cons fix sele fixed1 .or. fixed2 .or. fixed3 end 

define rigid1 sele ( resid 3:115 .and. segid PROA ) end
shape desc dock1 rigid sele rigid1 end 

define rigid1 sele ( resid 118:156 .and. segid PROA ) end
define rigid2 sele ( resid 163:188 .and. segid PROA ) end
shape desc dock2 rigid sele rigid1 .or. rigid2 end 

return 

