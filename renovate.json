{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "America/Los_Angeles",
  "schedule": ["before 6am on Monday"],
  "ignorePaths": ["apps/scoper/bilbomd-scoper-base.dockerfile"],
  "helm-values": {
    "managerFilePatterns": [
      "/infra/helm-nersc/values.*\\.yaml$/",
      "/infra/helm-berkelium/values.*\\.yaml$/"
    ]
  },
  "packageRules": [
    {
      "description": "In-house bilbomd images are auto-bumped on release by the sync-infra-image-tags CI job; Renovate ignores them",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/bl1231/bilbomd-backend",
        "ghcr.io/bl1231/bilbomd-ui",
        "ghcr.io/bl1231/bilbomd-worker",
        "ghcr.io/bl1231/bilbomd-scoper",
        "harbor.bk.lbl.gov/ghcr.io/bl1231/bilbomd-backend",
        "harbor.bk.lbl.gov/ghcr.io/bl1231/bilbomd-ui",
        "harbor.bk.lbl.gov/ghcr.io/bl1231/bilbomd-worker",
        "harbor.bk.lbl.gov/ghcr.io/bl1231/bilbomd-scoper"
      ],
      "enabled": false
    },
    {
      "description": "Berkelium pulls Docker Hub images through Harbor's proxy cache; look tags up on Docker Hub, keep the Harbor path in the file",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/^harbor\\.bk\\.lbl\\.gov\\/docker\\.io\\//"],
      "overridePackageName": "{{{replace '^harbor\\.bk\\.lbl\\.gov/docker\\.io/' '' packageName}}}"
    },
    {
      "description": "Berkelium pulls ghcr.io images through Harbor's proxy cache; look tags up on ghcr.io, keep the Harbor path in the file",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/^harbor\\.bk\\.lbl\\.gov\\/ghcr\\.io\\//"],
      "overridePackageName": "{{{replace '^harbor\\.bk\\.lbl\\.gov/' '' packageName}}}"
    },
    {
      "description": "Group container image updates across compose and helm into one PR",
      "matchManagers": ["docker-compose", "helm-values"],
      "matchDatasources": ["docker"],
      "groupName": "container images",
      "groupSlug": "container-images"
    },
    {
      "description": "Group all minor and patch npm updates into one PR",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm dependencies (non-major)",
      "groupSlug": "npm-non-major"
    },
    {
      "description": "Group GitHub Actions updates into one PR",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions"
    }
  ]
}
