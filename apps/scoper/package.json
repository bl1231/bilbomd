{
  "name": "@bilbomd/scoper",
  "description": "A worker app to process BilboMD SCOPER jobs from BullMQ queue",
  "version": "1.7.19",
  "main": "build/scoper.js",
  "files": [
    "build",
    "scripts"
  ],
  "type": "module",
  "author": {
    "name": "Scott Classen",
    "email": "sclassen@lbl.gov"
  },
  "contributors": [
    {
      "name": "Edan Patt"
    },
    {
      "name": "Michal Hammel"
    },
    {
      "name": "Dina Schneidman"
    }
  ],
  "scripts": {
    "clean": "rimraf build/*",
    "build": "pnpm run clean && pnpm run copy-assets && pnpm run tsc",
    "build:ci": "pnpm run clean && pnpm run copy-assets && pnpm run lint && pnpm run tsc",
    "copy-assets": "copyfiles --all --up 1 --exclude \"./**/*.{ts,tsx}\" \"./src/**/*\" ./build",
    "start": "npm run build && node build/scoper.js",
    "dev": "nodemon --watch src --ext ts,ejs --verbose --exec npm run start",
    "lint": "eslint",
    "tsc": "tsc",
    "test": "vitest --run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@bilbomd/mongodb-schema": "workspace:*",
    "bullmq": "^5.79.3",
    "dotenv": "^17.4.2",
    "fs-extra": "^11.3.6",
    "handlebars": "^4.7.9",
    "ioredis": "5.10.1",
    "moment-timezone": "^0.6.2",
    "mongoose": "^9.7.4",
    "nodemailer": "^9.0.3",
    "nodemailer-express-handlebars": "^7.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/nodemailer": "^8.0.1",
    "@types/nodemailer-express-handlebars": "^4.0.6",
    "@vitest/coverage-v8": "^4.1.10",
    "nodemon": "^3.1.14",
    "vitest": "^4.1.10"
  },
  "_moduleAliases": {
    "@services": "build/services",
    "@models": "build/models",
    "@helpers": "build/helpers"
  }
}
