{
  "name": "@bilbomd/ui",
  "version": "2.13.1",
  "description": "Frontend Single Page Web Application for BilboMD",
  "private": true,
  "type": "module",
  "homepage": "https://bilbomd.bl1231.als.lbl.gov",
  "author": {
    "name": "Scott Classen",
    "email": "sclassen@lbl.gov"
  },
  "contributors": [
    {
      "name": "Kai Classen",
      "email": "kai.ko.classen@icloud.com"
    },
    {
      "name": "Shreyas Prabhakar",
      "email": "ShreyasPrabhakar@lbl.gov"
    }
  ],
  "scripts": {
    "clean": "rimraf build/*",
    "dev": "GIT_HASH=$(git rev-parse --short HEAD) vite",
    "prebuild": "tsc && cp ../../LICENSE.txt public/LICENSE.txt",
    "vite-build": "vite build",
    "lint": "eslint",
    "build": "pnpm run clean && pnpm run vite-build",
    "build:ci": "pnpm run clean && pnpm run lint && pnpm run vite-build",
    "preview": "vite preview",
    "optimize": "vite optimize",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "related": "vitest related"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "vitest related --run",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@bilbomd/bilbomd-types": "workspace:*",
    "@bilbomd/mongodb-schema": "workspace:*",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@mui/system": "^9.0.0",
    "@mui/utils": "^9.0.0",
    "@mui/x-data-grid": "^9.0.0",
    "@reduxjs/toolkit": "^2.11.2",
    "axios": "^1.15.0",
    "axios-retry": "^4.5.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "form-data": "^4.0.5",
    "formik": "^2.4.9",
    "jwt-decode": "^4.0.0",
    "molstar": "^5.8.0",
    "notistack": "^3.0.2",
    "prop-types": "^15.8.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-dropzone": "^15.0.0",
    "react-error-boundary": "^6.1.1",
    "react-icons": "^5.6.0",
    "react-redux": "^9.2.0",
    "react-router": "^7.14.0",
    "react-smooth": "^4.0.4",
    "react-spinners": "^0.17.0",
    "recharts": "^3.8.1",
    "yup": "^1.7.1"
  },
  "overrides": {
    "react-is": "^19.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-redux": "^7.1.34",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "jsdom": "^29.0.2",
    "msw": "^2.13.2",
    "redux-mock-store": "^1.5.5",
    "sass-embedded": "^1.99.0",
    "type-fest": "^5.5.0",
    "vite": "^8.0.7"
  }
}
