{
  "name": "@bilbomd/backend",
  "version": "2.5.8",
  "description": "Backend server for BilboMD webapp",
  "main": "dist/server.js",
  "files": [
    "dist",
    "public",
    "views",
    "scripts"
  ],
  "type": "module",
  "scripts": {
    "clean": "rimraf dist/*",
    "copy-assets": "copyfiles --all --up 1 --exclude \"./**/*.{ts,tsx}\" \"./src/**/*\" ./dist",
    "lint": "eslint",
    "tsc": "tsc",
    "build": "npm-run-all clean copy-assets tsc",
    "build:ci": "npm-run-all clean copy-assets lint tsc",
    "dev": "concurrently \"npm run watch-ts\" \"nodemon dist/server.js\"",
    "watch-ts": "tsc -w",
    "start": "npm run build && node dist/server.js",
    "test": "vitest --run --coverage",
    "test:watch": "vitest",
    "test:integration": "vitest --run --coverage test/integration --config vitest.integration.config.ts",
    "test:integration:compose": "docker compose --env-file ../../infra/.env.local -f ../../infra/docker-compose.local.yml -p bilbomd-local up -d mongodb && sleep 10 && vitest --run --config vitest.integration.config.ts && docker compose -f ../../infra/docker-compose.local.yml -p bilbomd-local down",
    "test:integration:watch": "vitest test/integration --config vitest.integration.config.ts",
    "server": "nodemon ."
  },
  "dependencies": {
    "@bilbomd/bilbomd-types": "workspace:*",
    "@bilbomd/md-utils": "workspace:*",
    "@bilbomd/mongodb-schema": "workspace:*",
    "@bull-board/api": "^6.19.0",
    "@bull-board/express": "^6.19.0",
    "@types/swagger-ui-express": "^4.1.8",
    "axios": "^1.13.5",
    "bullmq": "^5.70.1",
    "cookie-parser": "~1.4.7",
    "cors": "^2.8.6",
    "cron": "^4.4.0",
    "dotenv": "^17.3.1",
    "eslint-plugin-jest": "^29.15.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.19.0",
    "express-winston": "^4.2.0",
    "fs-extra": "^11.3.3",
    "handlebars": "^4.7.8",
    "ioredis": "^5.9.3",
    "jsonwebtoken": "^9.0.3",
    "moment-timezone": "^0.6.0",
    "mongoose": "^9.2.2",
    "mongoose-to-swagger": "^1.5.1",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.1",
    "nodemailer-express-handlebars": "^7.0.0",
    "openid-client": "~6.8.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "typescript": "^5.9.3",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "yaml": "^2.8.2",
    "yup": "^1.7.1"
  }
}