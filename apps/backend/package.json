{
  "name": "@bilbomd/backend",
  "version": "2.9.14",
  "description": "Backend server for BilboMD webapp",
  "main": "dist/server.js",
  "files": [
    "dist",
    "public",
    "views",
    "scripts"
  ],
  "type": "module",
  "scripts": {
    "clean": "rimraf dist/*",
    "copy-assets": "copyfiles --all --up 1 --exclude \"./**/*.{ts,tsx}\" \"./src/**/*\" ./dist",
    "lint": "eslint",
    "tsc": "tsc",
    "build": "pnpm run clean && pnpm run copy-assets && pnpm run tsc",
    "build:ci": "pnpm run clean && pnpm run copy-assets && pnpm run lint && pnpm run tsc",
    "dev": "concurrently \"npm run watch-ts\" \"nodemon dist/server.js\"",
    "watch-ts": "tsc -w",
    "start": "npm run build && node dist/server.js",
    "test": "vitest --run --coverage",
    "test:watch": "vitest",
    "test:integration": "vitest --run --coverage test/integration --config vitest.integration.config.ts",
    "test:integration:compose": "docker compose --env-file ../../infra/.env.local -f ../../infra/docker-compose.local.yml -p bilbomd-local up -d mongodb && sleep 10 && vitest --run --config vitest.integration.config.ts && docker compose -f ../../infra/docker-compose.local.yml -p bilbomd-local down",
    "test:integration:watch": "vitest test/integration --config vitest.integration.config.ts",
    "server": "nodemon ."
  },
  "dependencies": {
    "@bilbomd/bilbomd-types": "workspace:*",
    "@bilbomd/md-utils": "workspace:*",
    "@bilbomd/mongodb-schema": "workspace:*",
    "@bull-board/api": "^8.0.1",
    "@bull-board/express": "^8.0.1",
    "axios": "^1.18.1",
    "bullmq": "^5.79.1",
    "connect-redis": "^9.0.0",
    "cookie-parser": "~1.4.7",
    "cors": "^2.8.6",
    "cron": "^4.4.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "express-winston": "^4.2.0",
    "fs-extra": "^11.3.5",
    "handlebars": "^4.7.9",
    "ioredis": "5.10.1",
    "jsonwebtoken": "^9.0.3",
    "moment-timezone": "^0.6.2",
    "mongoose": "^9.7.2",
    "mongoose-to-swagger": "^1.5.1",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.1",
    "nodemailer-express-handlebars": "^7.0.0",
    "openid-client": "~6.8.4",
    "redis": "^6.0.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "yaml": "^2.9.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/nodemailer": "^8.0.1",
    "@types/nodemailer-express-handlebars": "^4.0.6",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "concurrently": "^10.0.3",
    "eslint-plugin-jest": "^29.15.2",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3"
  }
}
