* CHARMM Topology and Parameter files for BilboMD
* Updated April 2026 to use CHARMM c49b2 bundled toppar

! Protein Topology and Parameter (CHARMM36m)
open read card unit 10 name /app/charmm-toppar/top_all36_prot.rtf
read  rtf card unit 10

open read card unit 20 name /app/charmm-toppar/par_all36m_prot.prm
read para card unit 20 flex

! Nucleic Acids
open read card unit 10 name /app/charmm-toppar/top_all36_na.rtf
read  rtf card unit 10 append

open read card unit 20 name /app/charmm-toppar/par_all36_na.prm
read para card unit 20 append flex

! Carbohydrates
open read card unit 10 name /app/charmm-toppar/top_all36_carb.rtf
read  rtf card unit 10 append

open read card unit 20 name /app/charmm-toppar/par_all36_carb.prm
read para card unit 20 append flex

! CGENFF
open read card unit 10 name /app/charmm-toppar/top_all36_cgenff.rtf
read  rtf card unit 10 append

open read card unit 20 name /app/charmm-toppar/par_all36_cgenff.prm
read para card unit 20 append flex

! Glycopeptide
stream /app/charmm-toppar/stream/carb/toppar_all36_carb_glycopeptide.str

! Protein additional parameters
stream /app/charmm-toppar/stream/prot/toppar_all36_prot_fluoro_alkanes.str
stream /app/charmm-toppar/stream/prot/toppar_all36_prot_na_combined.str

! Nucleic acid additional parameters
stream /app/charmm-toppar/stream/na/toppar_all36_na_nad_ppi.str

! Additional topologies and parameters for protein
stream /app/charmm-toppar/stream/prot/toppar_all36_prot_heme.str
stream /app/charmm-toppar/stream/prot/toppar_all36_prot_retinol.str

! Cofactors including FAD (Aleksandrov, J. Comput. Chem. 2019)
stream /app/charmm-toppar/stream/prot/toppar_all36_prot_cofactors.str
